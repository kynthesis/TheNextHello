; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Next Hello"
run/main_scene="res://scenes/social.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
MCPGameInspector="*res://addons/swallowtail/services/game_inspector.gd"

[display]

window/size/viewport_width=414
window/size/viewport_height=896
window/size/window_width_override=414
window/size/window_height_override=896

[editor_plugins]

enabled=PackedStringArray("res://addons/swallowtail/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg")

[gui]

theme/default_font_multichannel_signed_distance_field=true

[internationalization]

locale/translations_pot_files=PackedStringArray("res://content/dialogue/act_01.dialogue", "res://content/dialogue/act_02.dialogue", "res://content/dialogue/act_03.dialogue", "res://content/dialogue/act_04.dialogue", "res://content/dialogue/act_05.dialogue", "res://content/dialogue/act_06.dialogue")

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[swallowtail]

runtime/direct_server=true
